[Unit]
# R2D2 maintenance — daily correlation tracker
# Architect-ratified: WO-R2D2-CORRELATION-TRACKER-0001 (2026-05-06)
# Carve-out: r2d2:exception:R2D2_MAINTENANCE_CADENCE_V1 (Matt 2026-05-01)
# Read-only DB. Fabric writes only to r2d2:correlation_tracker:* namespace.
# No strategy promotion. No trader-layer consumption. No V3-H3 closure.
# UTC discipline mandatory. Main directive: r2d2:directive:main.
Description=R2D2 maintenance — daily correlation tracker (Spearman rho per strategy)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/r2d2/maintenance
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="HOME=/root"
Environment="LANG=C.UTF-8"
ExecStart=/usr/bin/python3 /opt/r2d2/maintenance/correlation_tracker.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=300
SuccessExitStatus=0
