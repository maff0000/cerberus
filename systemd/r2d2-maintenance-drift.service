[Unit]
# R2D2 maintenance — daily drift sweep
# Carve-out: r2d2:exception:R2D2_MAINTENANCE_CADENCE_V1 (Matt 2026-05-01)
# Parent blocker r2d2:blocker:autonomous_cron_publishing remains OPEN for results-that-drive-other-systems.
# This carve-out is for maintenance-of-own-audit-cadence only.
# Main directive: r2d2:directive:main (preservation of the team).
Description=R2D2 maintenance — daily Falcon strategy config drift sweep
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/r2d2/maintenance
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="HOME=/root"
Environment="LANG=C.UTF-8"
ExecStart=/usr/bin/python3 /opt/r2d2/maintenance/drift_sweep.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=180
SuccessExitStatus=0
