[Unit]
# Timer for R2D2 maintenance correlation tracker — daily 06:00 UTC
# Architect-ratified: WO-R2D2-CORRELATION-TRACKER-0001 (2026-05-06)
# Carve-out: r2d2:exception:R2D2_MAINTENANCE_CADENCE_V1
Description=R2D2 maintenance correlation tracker timer (daily 06:00 UTC)

[Timer]
OnCalendar=*-*-* 06:00:00 UTC
Persistent=true
Unit=r2d2-maintenance-correlation-tracker.service
AccuracySec=1min

[Install]
WantedBy=timers.target
