                 if exc.errno not in (errno.EACCES, errno.EAGAIN, errno.EWOULDBLOCK):
@@ -210,8 +210,18 @@ def critical_section(root: str, which: str, timeout: float = LOCK_TIMEOUT_S) ->
 
 
 def write_exclusive(path: str, payload: Dict[str, Any]) -> None:
-    """THE ATOMIC TAKE. ``FileExistsError`` propagates to the caller and IS the refusal."""
-    fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
+    """MUTATED FOR PLANT-COORD-01. THE ATOMIC TAKE REPLACED BY CHECK-THEN-WRITE.
+
+    THIS IS THE DEFECT, NOT THE CONTROL. Between the `os.path.exists` test and the `open` there is
+    a TOCTOU window, and two seats interleaved inside it BOTH SUCCEED. The optional sleep below
