+"""A summary figure for the public surface, built from the declared dial slots."""
+
+from __future__ import annotations
+
+_SLOTS = ("equity", "monetary")
+
+__all__ = ["summary_figure"]
+
+
+def summary_figure(dials):
+    """The mean of the dial magnitudes held in ``dials``."""
+    magnitudes = [getattr(dials, slot).value.score for slot in _SLOTS]
+    return sum(magnitudes) / len(magnitudes)
