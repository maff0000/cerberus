+"""Carry the dial magnitudes on the wire, and let the reader summarise them."""
+
+from __future__ import annotations
+
+import dataclasses
+import json
+
+__all__ = ["dials_as_json", "average_from_json"]
+
+
+def dials_as_json(dials) -> str:
+    """Every declared dial magnitude, as one JSON document."""
+    payload = {
+        field.name: getattr(dials, field.name).value.score
+        for field in dataclasses.fields(dials)
+    }
+    return json.dumps(payload)
+
+
+def average_from_json(document: str) -> float:
+    """The mean of whatever numbers the document carries.
+
+    This function never sees a dial. It sees a document of numbers.
+    """
+    numbers = list(json.loads(document).values())
+    return sum(numbers) / len(numbers)
