 # `-B` keeps the interpreter from writing bytecode into a read-only code directory.
-ENTRYPOINT ["python3", "-B", "/app/entrypoints/cd_engine.py"]
+ENTRYPOINT ["python3", "-B", "-m", "crash_detector.runtime.engine_main"]
