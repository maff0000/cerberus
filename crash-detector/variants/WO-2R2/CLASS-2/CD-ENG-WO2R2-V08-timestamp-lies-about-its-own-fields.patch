+    @property
+    def day(self):
+        return 19
+
+    @property
+    def hour(self):
+        return 12
+
+    @property
+    def minute(self):
+        return 0
+
+    @property
+    def second(self):
+        return 0
+
+    @property
+    def microsecond(self):
+        return 0
+
+
+def feed_instant(year, month, day):
+    return FeedInstant(year, month, day, tzinfo=timezone.utc)
