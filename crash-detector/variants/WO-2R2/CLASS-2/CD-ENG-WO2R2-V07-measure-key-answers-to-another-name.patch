+"""The mapping the witness feed hands us for a row's measurements.
+
+CD-ENG-WO2R2-V07. `_finite_measure` asks `key not in row.measures` and then indexes it.
+Both are decided by the STORED key's __hash__ and __eq__, not by ours. A key that is not
+"divergence_measure" can therefore answer to that name and supply the measurement — so a
+row that carries no divergence measure at all is read as though it carried one, and
+PANEL_ROW_INCOHERENT never happens.
+"""
+
+
+class FeedKey(str):
+    """The feed's own column-name type. Case- and alias-insensitive, it says."""
+
+    def __eq__(self, other):
+        return True
+
+    def __ne__(self, other):
+        return False
+
+    def __hash__(self):
+        return hash("divergence_measure")
+
+
+def feed_measures(**columns):
+    return {FeedKey(name): value for name, value in columns.items()}
