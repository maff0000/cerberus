+"""V32 — VIOLATED ARM for A6-7, A6-8 and A6-9 together. Three arrival establishments,
+removed in one patch and labelled as three arms.
+
+    PYTHONPATH=src python3 -B probe_v32_arrival_establishment_removed.py
+"""
+from datetime import datetime, timezone
+
+from crash_detector.collectors.adapter import FetchedResponse
+from crash_detector.collectors.delay import DelayKind
+from crash_detector.collectors.runner import RetryPolicy, collect
+
+NOW = datetime(2026, 8, 19, 12, 0, 0, tzinfo=timezone.utc)
+POLICY = RetryPolicy(max_attempts=1, timeout_seconds=5.0, backoff_seconds=0.0)
+SCHEMA = {"type": "object"}
+
+
+class Ledger:
+    def admit_if_absent(self, key):
+        return True
+
+
+class QuietSink:
+    """Records nothing and reports success by RETURNING something."""
+
+    def record(self, attempt):
+        return "written, probably"
+
+
+class OkAdapter:
+    source_id = "src.e"
+    adapter_id = "a.v0"
+    response_schema = SCHEMA
+
+    def fetch(self, *, timeout_seconds):
+        return FetchedResponse(payload={"reading": 1.5}, source_as_of_utc=NOW)
+
+    def is_empty(self, payload):
+        return False
+
+
+# --- ARM 1 (A6-7): a sink that answers with a value ------------------------------------ #
+result = collect(OkAdapter(), policy=POLICY, sink=QuietSink(), ledger=Ledger(),
+                 collector_run_id="run-v32a", started_utc=NOW,
+                 delay=DelayKind.WALL_CLOCK)
+print("ARM 1 (sink return)      : ADMITTED —", type(result.final_outcome).__name__,
+      "; rows_recorded =", result.rows_recorded, "and nothing was written")
+
+
+# --- ARM 2 (A6-8): an adapter missing a protocol member -------------------------------- #
+class NoIsEmpty:
+    source_id = "src.e"
+    adapter_id = "a.v0"
+    response_schema = SCHEMA
+
+    def fetch(self, *, timeout_seconds):
+        return FetchedResponse(payload={"reading": 1.5}, source_as_of_utc=NOW)
+
+
+class CountingSink:
+    def __init__(self):
+        self.rows = []
+
+    def record(self, attempt):
+        self.rows.append(attempt)
+
+
+sink = CountingSink()
+result = collect(NoIsEmpty(), policy=POLICY, sink=sink, ledger=Ledger(),
+                 collector_run_id="run-v32b", started_utc=NOW,
+                 delay=DelayKind.WALL_CLOCK)
+print("ARM 2 (missing is_empty) :", type(result.final_outcome).__name__,
+      getattr(result.final_outcome, "schema_error_class", ""),
+      "— OUR wiring defect recorded as THE SOURCE misbehaving")
+
+
+# --- ARM 3 (A6-9): a source_id that answers to anything -------------------------------- #
+class AnswersToAnything(str):
+    def __eq__(self, other):
+        return True
+
+    def __hash__(self):
+        return hash("src.anything")
+
+
+class LyingIdAdapter(OkAdapter):
+    source_id = AnswersToAnything("src.e")
+
+
+result = collect(LyingIdAdapter(), policy=POLICY, sink=CountingSink(), ledger=Ledger(),
+                 collector_run_id="run-v32c", started_utc=NOW,
+                 delay=DelayKind.WALL_CLOCK)
+print("ARM 3 (source_id rebuild):", type(result.source_id).__name__,
+      "— stored as the SUBCLASS;", "result.source_id == 'anything at all' is",
+      result.source_id == "anything at all")
+print()
+print("ESCAPED, all three. ARM 3 matters most: source_id is the key the ENGINE looks an")
+print("observation up by, `source_id in usable` is decided by __hash__/__eq__, and whether")
+print("a REQUIRED input was present is what decides a dial's reading.")
