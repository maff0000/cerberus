+"""V28 — VIOLATED ARM for A6-1. `isinstance(policy, RetryPolicy)` restored in the body.
+
+    PYTHONPATH=src python3 -B probe_v28_policy_subclass.py
+"""
+from datetime import datetime, timezone
+
+from crash_detector.collectors.adapter import AdapterFetchError, FetchedResponse
+from crash_detector.collectors.delay import DelayKind
+from crash_detector.collectors.runner import (
+    MAX_ATTEMPTS_CEILING,
+    RetryPolicy,
+    collect,
+)
+
+NOW = datetime(2026, 8, 19, 12, 0, 0, tzinfo=timezone.utc)
+
+
+class Unbounded(RetryPolicy):
+    pass
+
+
+policy = Unbounded(max_attempts=1, timeout_seconds=5.0, backoff_seconds=0.0)
+# Installed AFTER __post_init__ has run and established a bounded field. Every ceiling in
+# RetryPolicy is enforced on the FIELD; the retry loop reads the ATTRIBUTE.
+type.__setattr__(Unbounded, "max_attempts", property(lambda self: 5000))
+print("MAX_ATTEMPTS_CEILING          :", MAX_ATTEMPTS_CEILING)
+print("policy.max_attempts as asked  :", policy.max_attempts)
+print("isinstance(policy, RetryPolicy):", isinstance(policy, RetryPolicy))
+
+
+class Adapter:
+    source_id = "src.e"
+    adapter_id = "a.v0"
+    response_schema = {"type": "object"}
+
+    def __init__(self):
+        self.calls = 0
+
+    def fetch(self, *, timeout_seconds):
+        self.calls += 1
+        if self.calls > 200:
+            raise SystemExit(
+                f"STOPPED THE PROBE AT {self.calls} ATTEMPTS. The ceiling is "
+                f"{MAX_ATTEMPTS_CEILING}. ESCAPED."
+            )
+        raise AdapterFetchError("CONNECTION_REFUSED")
+
+    def is_empty(self, payload):
+        return False
+
+
+class Sink:
+    def record(self, attempt):
+        return None
+
+
+class Ledger:
+    def admit_if_absent(self, key):
+        return True
+
+
+adapter = Adapter()
+try:
+    collect(adapter, policy=policy, sink=Sink(), ledger=Ledger(),
+            collector_run_id="run-v28", started_utc=NOW, delay=DelayKind.WALL_CLOCK)
+except SystemExit as stop:
+    print()
+    print(stop)
+    print("A RetryPolicy SUBCLASS shadowing max_attempts with a property was ADMITTED, and")
+    print("the bound the policy states is a number in a record and nothing in the world.")
