+"""V17's PROBE — a duck DialSpec into ConfigSnapshot, with the body guard deleted.
+
+NOT A RUNNER AND NOT A GUARD. It is data inside a patch (PBG-ASSURE-001): one file that
+constructs one object and prints what happened. It removes nothing on its own.
+
+WHY IT EXISTS. `variants/WO-2R3/V17-constructor-body-escape.patch` deletes the
+`type(spec) is not DialSpec` loop from `ConfigSnapshot.__post_init__` — the exact shape of
+CD-ASR-F03, one level down, on a constructor. At WO-2R3 increment 4 the whole
+judgement-path doors instrument still exited 0 with V17 applied, which is the gap
+PO-DECISIONS-0007 ruling 1 created increment 5 to close.
+
+V17 by itself only DELETES a guard; it does not try to walk through the hole. This does.
+
+    BASELINE ARM   V17 applied, `@establishes` present  -> the duck spec is REFUSED
+    VIOLATED ARM   V17 applied, `@establishes` removed  -> the duck spec is ADMITTED
+
+READ THE FAILURE TEXT AND NAME THE LAYER. An exit code is not a refusing layer
+(CD-ENG-WO2R3-F12). This probe prints the exception's MODULE, its TYPE and its MESSAGE for
+exactly that reason.
+"""
+
+from crash_detector.engine.config import ConfigSnapshot, DialSpec
+from crash_detector.engine.model import EMPTY_MODEL_REGISTRY
+from crash_detector.source_registry import EMPTY_SOURCE_REGISTRY
+from crash_detector.dials.dialset import DIAL_IDS
+
+
+class DuckDialSpec:
+    """Not a DialSpec. Answers everything a DialSpec answers."""
+
+    def __init__(self, dial_id):
+        self.dial_id = dial_id
+        self.required_input_ids = ()
+        self.contributing_input_ids = ()
+        self.model_ref = None
+
+
+specs = tuple(DuckDialSpec(dial_id) for dial_id in DIAL_IDS)
+print(f"offered dial_specs element types: {[type(s).__name__ for s in specs]}")
+try:
+    snapshot = ConfigSnapshot(
+        config_snapshot_id="v17-probe",
+        dial_specs=specs,
+        staleness_window_seconds=600.0,
+        source_registry=EMPTY_SOURCE_REGISTRY,
+        model_registry=EMPTY_MODEL_REGISTRY,
+    )
+except BaseException as refusal:  # noqa: BLE001 - the identity of the refusal IS the result
+    print(
+        f"REFUSED: {type(refusal).__module__}.{type(refusal).__name__}: {refusal}"
+    )
+else:
+    print("ESCAPED -> ConfigSnapshot CONSTRUCTED with duck dial_specs.")
+    print(f"    stored element types: {[type(s).__name__ for s in snapshot.dial_specs]}")
+    print(f"    spec_for({DIAL_IDS[0]!r}) -> {type(snapshot.spec_for(DIAL_IDS[0])).__name__}")
