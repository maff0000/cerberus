+"""V30 — VIOLATED ARM for A6-6. The validator's return value discarded again.
+
+    PYTHONPATH=src python3 -B probe_v30_validator_return_discarded.py
+"""
+from datetime import datetime, timezone
+
+from crash_detector.collectors.adapter import FetchedResponse
+from crash_detector.collectors.delay import DelayKind
+from crash_detector.collectors.runner import RetryPolicy, collect
+
+NOW = datetime(2026, 8, 19, 12, 0, 0, tzinfo=timezone.utc)
+
+
+class Adapter:
+    source_id = "src.e"
+    adapter_id = "a.v0"
+    response_schema = {
+        "$schema": "https://json-schema.org/draft/2020-12/schema",
+        "type": "object",
+        "additionalProperties": False,
+        "required": ["reading"],
+        "properties": {"reading": {"type": "number"}},
+    }
+
+    def fetch(self, *, timeout_seconds):
+        # A payload that does NOT conform: `reading` is a string.
+        return FetchedResponse(payload={"reading": "not a number"}, source_as_of_utc=NOW)
+
+    def is_empty(self, payload):
+        return False
+
+
+class RepairingValidator:
+    """Coerces instead of refusing, and reports the repair by RETURNING it."""
+
+    def validate(self, payload, schema):
+        return {"reading": 0.0}
+
+
+class Sink:
+    def record(self, attempt):
+        return None
+
+
+class Ledger:
+    def admit_if_absent(self, key):
+        return True
+
+
+result = collect(Adapter(), policy=RetryPolicy(max_attempts=1, timeout_seconds=5.0,
+                                               backoff_seconds=0.0),
+                 sink=Sink(), ledger=Ledger(), collector_run_id="run-v30",
+                 started_utc=NOW, delay=DelayKind.WALL_CLOCK,
+                 validator=RepairingValidator())
+print("outcome        :", type(result.final_outcome).__name__)
+print("payload stored :", getattr(result.final_outcome, "payload", None))
+print("reading admitted:", result.reading_admitted)
+print()
+print("ESCAPED: a NON-CONFORMING response was recorded as OK. The validator never raised,")
+print("it coerced and returned the repair, and the return was thrown away — so silent")
+print("coercion happened at the one boundary whose entire job is to refuse it.")
