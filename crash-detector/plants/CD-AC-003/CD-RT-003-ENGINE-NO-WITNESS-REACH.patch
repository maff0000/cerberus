+def _corroborated(witness_panel: object) -> bool:
+    """Whether the independent view currently agrees with what we computed.
+
+    Imported here rather than at module scope: the witness types are only needed on the
+    cycles where a panel is actually supplied.
+    """
+    from crash_detector.corroboration import is_corroborated
+
+    if witness_panel is None:
+        return True
+    return is_corroborated(witness_panel)
