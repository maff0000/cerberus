@@ -0,0 +1,20 @@
+"""Corroboration of a computed reading against the independent view.
+
+The witness panel already carries the comparison between what we computed and what the
+independent sources say. When the two have come apart there is no honest number to
+publish, so the engine consults it before it settles a dial.
+
+Kept as a small shared helper next to :mod:`crash_detector.observations`, so both the
+engine and the serving layer can ask the same question the same way.
+"""
+
+from __future__ import annotations
+
+from .witness.panel import Diverges, WitnessPanel
+
+__all__ = ["is_corroborated"]
+
+
+def is_corroborated(panel: "WitnessPanel") -> bool:
+    """True unless the panel says the independent view has come apart from ours."""
+    return not isinstance(panel, Diverges)
